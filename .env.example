# Copy to your host's environment settings. Never commit real values.

# The address people use, with a trailing slash. Used in texts and email links.
PUBLIC_URL=https://book.example.com/

# off = start empty with only your owner login (use this for the real site).
# Leave unset to load the sample companies for testing.
SAMPLE_DATA=off

# Your platform owner login, created on the very first start only.
OWNER_NAME=Dawit Werede
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=choose-a-long-password

# Where the data lives. Must be on a persistent disk.
DATA_FILE=/data/db.json

# Set to 1 when the app sits behind the host's proxy (Render, Railway, Fly).
TRUST_PROXY=1

# PORT is usually set by the host.

# ---- Real services. Each one is simulated until its settings are added. ----
# See DEPLOY.md, "Switching on real services".

# Texts (Twilio). TWILIO_FROM is your number (+12065550100) or a Messaging Service ID (MG...).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# Wake-up calls to drivers: a Twilio phone number with voice. Only needed when TWILIO_FROM is a Messaging Service (MG...).
# TWILIO_VOICE_FROM=

# Email (Resend). The sender name is each limo company's name.
# RESEND_API_KEY=
# EMAIL_FROM=Bookings <bookings@yourdomain.com>

# Card payments (Stripe Connect). Use sk_test_ first.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Maps: Routes API + Places API (New).
# GOOGLE_MAPS_API_KEY=
# Street maps on the dispatch board: a separate key for Maps JavaScript API,
# restricted to your website address (it is sent to the browser).
# GOOGLE_MAPS_BROWSER_KEY=

# Flight tracking (FlightAware AeroAPI).
# FLIGHTAWARE_API_KEY=

# Phone notifications with the app closed (Web Push) need nothing here: the key is
# made on first start and kept in vapid.json next to the data. Optional:
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# WEB_PUSH=off

# ---- App Store and Google Play apps: phone notifications --------------------
# Android, through Firebase: paste the whole service account JSON on one line.
# FCM_SERVICE_ACCOUNT=
# iPhone, straight to Apple: the .p8 key text (Keys > Apple Push Notifications).
# APNS_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.example.app
# APNS_SANDBOX=on   only for test builds run from Xcode
